# Surprise Museum: client-side environment variables
#
# Copy to .env.local for local development. Never commit real values.
# Every VITE_ variable is compiled into the public static bundle on GitHub Pages,
# so these must never hold a secret. Security rests on Edge Functions and RLS
# (docs/architecture.md, section 10), not on these values being hidden.
#
# In GitHub, add these as repository Variables (Settings > Secrets and variables >
# Actions > Variables). Secrets also work, but nothing here is secret.

# Supabase project URL, for example https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (legacy JWT) key or publishable key (sb_publishable_...). Public by design.
VITE_SUPABASE_ANON_KEY=

# Optional. Region that Edge Functions run in, so they sit next to the Sydney database.
# Defaults to ap-southeast-2 when blank.
VITE_SUPABASE_FUNCTIONS_REGION=ap-southeast-2

# -----------------------------------------------------------------------------
# NOT for this file. Listed here so nothing is forgotten.
#
# Edge Function secrets (set with `supabase secrets set`, see supabase/functions/.env.example):
#   ALLOWED_ORIGINS, CRON_SECRET, RATE_LIMIT_SALT
#   SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
#
# GitHub Actions secrets for deploying migrations and functions (devops-engineer):
#   SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
#
# Supabase Vault secrets used by the pg_cron purge job (set once in the SQL editor):
#   project_url, cron_secret
# -----------------------------------------------------------------------------
