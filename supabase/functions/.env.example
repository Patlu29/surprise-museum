# Edge Function secrets. Never commit real values.
# Local: copy to supabase/functions/.env and run `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set --env-file supabase/functions/.env`
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Comma-separated list of origins allowed by CORS. No trailing slashes.
ALLOWED_ORIGINS=https://patlu29.github.io,http://localhost:5173,http://localhost:4173

# Shared secret that the pg_cron job sends in the x-cron-secret header to purge-expired.
# Must equal the Vault secret named cron_secret. Generate with: openssl rand -base64 32
CRON_SECRET=

# Salt mixed into hashed client IP addresses for rate limiting, so raw IPs are never stored.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=

# Local development only (`supabase functions serve`): the URL your browser uses to reach Storage.
# Inside the local Edge Runtime SUPABASE_URL is an internal address, so signed upload and download
# URLs would not open in the browser. Leave this blank in the hosted project.
# PUBLIC_API_URL=http://127.0.0.1:54321

# Do not add SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY here: Supabase injects both, and the CLI
# refuses secrets whose names start with SUPABASE_.
