# Public registry: CI and every contributor resolve the same packages, whatever the machine-wide npm config says (ADR 0013).
registry=https://registry.npmjs.org/
# Pin exact versions on install: R3F caps React's range, so a caret could pull an incompatible release (architecture section 2).
save-exact=true
# Refuse to install on a Node older than package.json "engines" (>=22.12.0) instead of failing later with obscure errors.
engine-strict=true
